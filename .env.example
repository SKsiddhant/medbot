# ============================================================
# MedBot — environment variables
# Copy to `.env` and fill in real values before running.
# ============================================================

# --- App ---
APP_ENV=development           # development | staging | production
APP_PORT=8000
LOG_LEVEL=INFO
# Signs login tokens. Required when APP_ENV=production. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Comma-separated allowed browser origins (default * is fine for local dev only)
CORS_ORIGINS=*

# --- Hugging Face ---
# Get a free read token from https://huggingface.co/settings/tokens
HF_API_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
HF_NER_MODEL=d4data/biomedical-ner-all
HF_DIALOGUE_MODEL=mistralai/Mistral-7B-Instruct-v0.3
# If USE_HF_INFERENCE_API=true → call HF hosted endpoint (no GPU needed)
# If false → load model locally with transformers (needs GPU / big RAM)
USE_HF_INFERENCE_API=true

# --- Twilio (SMS + WhatsApp) ---
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_SMS_FROM=+1234567890
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886    # sandbox default

# --- Meta WhatsApp Cloud API (optional, preferred once approved) ---
META_WHATSAPP_TOKEN=EAAxxxxxxxxxxxxxxxxxxxxxxxxxxx
META_PHONE_NUMBER_ID=1234567890
META_VERIFY_TOKEN=pick_any_random_string_for_webhook_verify

# --- Database ---
DATABASE_URL=postgresql+psycopg2://medbot:medbot@localhost:5432/medbot
REDIS_URL=redis://localhost:6379/0

# --- Doctor booking (optional real integrations) ---
PRACTO_API_KEY=
PRACTO_API_BASE=https://api.practo.com

# --- Safety / compliance ---
EMERGENCY_HELPLINE=112         # India national emergency
SUPPORT_EMAIL=support@yourdomain.in
DISCLAIMER="MedBot is an AI triage assistant, not a doctor. In an emergency call 112."
